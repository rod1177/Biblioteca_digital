{
  "name": "biblioteca_digital",
  "version": "1.0.0",
  "description": "Biblioteca Digital - Script de inicio unificado",
  "scripts": {
    "install:all": "pnpm install --filter backend && pnpm install --filter frontend",
    "dev": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"blue,green\" \"pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "start": "pnpm --filter backend start",
    "test": "pnpm --filter backend test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}